{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taamenn",
  "compatibility_date": "2026-09-16",
  "main": "./worker/index.js",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Binding required by worker/index.js and backend/src/workerAdapter.mjs.
  // Local `vite preview` uses Miniflare and does not need a remote id.
  // A real 32-character namespace id is required before `wrangler deploy`.
  // This environment cannot create one (no Cloudflare API token; dashboard
  // changes are out of scope). One-time operator step after `wrangler login`:
  //   npx wrangler kv namespace create TAAMEN_KV
  // then set "id" to the returned value. Do not invent an id.
  "kv_namespaces": [
    {
      "binding": "TAAMEN_KV"
    }
  ],
  "vars": {
    "EMAILJS_SERVICE_ID": "service_13mkb9h",
    "EMAILJS_CONTACT_TEMPLATE_ID": "template_jsugxta",
    "EMAILJS_AUTOREPLY_TEMPLATE_ID": "template_4pj4xlm",
    "EMAILJS_PUBLIC_KEY": "7xyuge5ZLIgBevcbL",
    "EMAILJS_ORIGIN": "https://taamenn.com",
    "REQUIRE_HTTPS": "false",
    "TRUST_PROXY": "true",
    "CORS_ORIGIN": "",
    "TAAMEN_SEED_EXAMPLE": "false"
  }
}
