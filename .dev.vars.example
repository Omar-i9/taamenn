# Cloudflare Worker local runtime (vite preview / wrangler).
# Copy to .dev.vars (never committed). Do not use VITE_* for these values.

NODE_ENV=development
REQUIRE_HTTPS=false
TRUST_PROXY=true
# Empty = same-origin (SPA and /api share the preview origin).
CORS_ORIGIN=

# Session lifetime in milliseconds (minimum enforced: 15 minutes).
SESSION_TTL_MS=28800000

# Seed DEV fixtures into local Miniflare KV only. Leave unset/false in production.
TAAMEN_SEED_EXAMPLE=true

# EmailJS Origin for the Worker. Production value; do not use http://localhost:5173.
EMAILJS_ORIGIN=https://taamenn.com

# Support contact. The recipient is server-side so the browser cannot choose it.
# Set the real address as a Cloudflare Worker secret named TAAMEN_SUPPORT_RECIPIENT
# (Workers & Pages → taamenn → Settings → Variables and Secrets). Never commit it.
TAAMEN_SUPPORT_RECIPIENT=
EMAILJS_SERVICE_ID=service_13mkb9h
EMAILJS_CONTACT_TEMPLATE_ID=template_jsugxta
EMAILJS_AUTOREPLY_TEMPLATE_ID=template_4pj4xlm
EMAILJS_PUBLIC_KEY=7xyuge5ZLIgBevcbL
# Required only when EmailJS Account → Security has "Use Private Key" enabled.
# If required, set it as a Cloudflare Worker secret named EMAILJS_PRIVATE_KEY.
EMAILJS_PRIVATE_KEY=
