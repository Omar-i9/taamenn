{
  "name": "taamen-2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "backend": "npm --prefix backend run dev",
    "provision:members": "npm --prefix backend run provision:members",
    "qa:final": "node scripts/qa-final.mjs",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "node --test --experimental-strip-types src/**/*.test.ts",
    "test": "node scripts/qa-final.mjs && npm run test:backend && npm run test:frontend"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.2.2",
    "typescript": "7.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "lucide-react": "1.42.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
