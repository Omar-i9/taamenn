# TAAMEN backend configuration. Copy to backend/.env (never committed).
PORT=8787
NODE_ENV=development

# Session lifetime in milliseconds (minimum enforced: 15 minutes).
SESSION_TTL_MS=28800000

# Comma-separated browser origins allowed to send credentialed requests.
# Leave empty for a same-origin deployment where the app and /api share one origin.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Reject plain HTTP. Enable in any HTTPS deployment.
REQUIRE_HTTPS=false

# Only enable when the process really sits behind a proxy that rewrites
# X-Forwarded-For / X-Forwarded-Proto. Otherwise clients could spoof them.
TRUST_PROXY=false

# Support contact. The recipient is server-side so the browser cannot choose it.
TAAMEN_SUPPORT_RECIPIENT=
EMAILJS_SERVICE_ID=service_13mkb9h
EMAILJS_CONTACT_TEMPLATE_ID=template_jsugxta
EMAILJS_AUTOREPLY_TEMPLATE_ID=template_4pj4xlm
EMAILJS_PUBLIC_KEY=7xyuge5ZLIgBevcbL
# Required only when EmailJS Account → Security has "Use Private Key" enabled.
EMAILJS_PRIVATE_KEY=
